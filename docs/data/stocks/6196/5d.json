      "url": "https://tw.stock.yahoo.com/news/%E5%85%AC%E5%91%8A-%E5%B8%86%E5%AE%A3114%E5%B9%B4%E5%BA%A6%E8%B2%A1%E5%8B%99%E5%A0%B1%E5%91%8A%E8%91%A3%E4%BA%8B%E6%9C%83%E5%8F%AC%E9%96%8B%E6%97%A5%E6%9C%9F%E7%82%BA115%E5%B9%B403%E6%9C%8803%E6%97%A5-065345044.html"
